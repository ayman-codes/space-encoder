        { "expr": "eos_asvd_param_ratio", "legendFormat": "{{job}}" }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Macro F1 delta",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "targets": [
        { "expr": "eos_asvd_f1_delta", "legendFormat": "{{job}}" }
      ]
    }
  ]
}
